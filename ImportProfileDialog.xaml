<Window x:Class="MsfsPhysicsCamera.ImportProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Profile" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Icon="icon.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Paste a profile share string (MSFSCAM...):" Margin="0,0,0,6" />
        <TextBox Grid.Row="1" x:Name="ShareInputBox" TextWrapping="Wrap" AcceptsReturn="False"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6"
                 TextChanged="ShareInputBox_TextChanged" />

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,8" />

        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Profile Name:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ProfileNameBox" Padding="4,2" TextChanged="ProfileNameBox_TextChanged" />
        </DockPanel>

        <TextBlock Grid.Row="4" Text="Decoded Settings Preview:" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Grid.Row="5" x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"
                 Background="#FFF7F7F7" Padding="6" Margin="0,0,0,10" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="ApplyAfterImportCheck" Content="Load after import" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Content="Add Profile" x:Name="AddButton" Width="95" Margin="0,0,8,0"
                    IsDefault="True" IsEnabled="False" Click="AddButton_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
